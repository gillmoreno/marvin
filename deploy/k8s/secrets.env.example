# copy to secrets.env (gitignored). LiveKit secret must be 32+ chars: openssl rand -hex 32
LIVEKIT_API_KEY=marvin
LIVEKIT_API_SECRET=replace-with-openssl-rand-hex-32
# Anthropic auth for the Claude Code harness: an API key (or Bedrock/Vertex credentials, see the Claude Agent SDK docs).
# Do not put a personal Claude Pro/Max OAuth token on a shared server: Anthropic's terms forbid using those outside
# Claude Code / claude.ai.
ANTHROPIC_API_KEY=
# Optional: lets the agent clone/push over HTTPS and use `gh pr create`.
GITHUB_TOKEN=
# Optional: "Connect GitHub" in Settings (device flow). Client id of an OAuth App with "Enable Device Flow" ticked;
# per-user tokens are encrypted with MARVIN_SESSION_SECRET (falls back to LIVEKIT_API_SECRET). docs_and_changelog/github.md
MARVIN_GITHUB_CLIENT_ID=
MARVIN_SESSION_SECRET=
# Optional override; Settings → Enterprise is the usual place (docs_and_changelog/licensing.md).
# MARVIN_LICENSE_KEY=
# MARVIN_ALLOWED_EMAIL_DOMAINS=
# MARVIN_AUDIT_S3_BUCKET=
# MARVIN_AUDIT_WEBHOOK=
