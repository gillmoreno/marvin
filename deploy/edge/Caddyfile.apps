# Concatenated in front of Caddyfile when MARVIN_DOMAIN is a real hostname (see docker-compose.edge.yml).
# Catch-all HTTPS + on-demand certs: each preview host (p3000.<MARVIN_DOMAIN>) gets its own name, not a wildcard
# cert. Caddy asks /tls-ask before issuing so a random name pointed at this IP cannot burn Let's Encrypt quota.
{
	on_demand_tls {
		ask http://web:8080/tls-ask
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	header {
		Content-Security-Policy "frame-ancestors https://{$MARVIN_SITE_ADDRESS}"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-X-Frame-Options
		-Server
	}
	reverse_proxy apps:8081
}
