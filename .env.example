# LiveKit (dev keys match `livekit-server --dev`)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# LAN IP of the machine running docker, advertised to browsers for WebRTC
NODE_IP=192.168.1.9
# Worker
MARVIN_ROOM=dev
MARVIN_REPO=/path/to/the/repo/marvin/works/in
MARVIN_WHISPER=small        # tiny|base|small|medium|large-v3-turbo (faster-whisper aliases)
MARVIN_LANGUAGE=            # e.g. en, it; empty = autodetect
# Coding agent ("harness") for rooms that do not pin one (rooms.yaml `harness:` / the picker in the UI).
# Ids: claude-code (Claude Agent SDK, default), and over the Agent Client Protocol: claude-acp, codex, cursor, gemini,
# opencode, grok, copilot. Each needs its own CLI on PATH and its own credentials; see docs_and_changelog/harnesses.md.
MARVIN_HARNESS=claude-code
# Override how one harness is launched (space-separated), e.g. to point at a wrapper or a pinned binary:
# MARVIN_HARNESS_CMD_OPENCODE=/opt/opencode/opencode acp
# Credentials for the harnesses you use. Anthropic: an API key or commercial (Bedrock/Vertex) credentials only;
# a personal Pro/Max OAuth token on a shared server violates Anthropic's terms.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # codex
# CURSOR_API_KEY=            # cursor
# GEMINI_API_KEY=            # gemini
# XAI_API_KEY=               # grok
# COPILOT_GITHUB_TOKEN=      # copilot (a GitHub account with Copilot)
