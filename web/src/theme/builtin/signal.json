{
  "id": "signal",
  "name": "Signal",
  "description": "Graphite glass with one luminous mint signal: it breathes while listening, tightens while working, turns amber while waiting, and lights up whoever speaks.",
  "author": "Marvin",
  "scheme": "dark",
  "fonts": {
    "ui": "Manrope",
    "display": "Manrope",
    "mono": "DM Mono",
    "google": "family=Manrope:wght@400;500;600;700;800&family=DM+Mono:wght@400;500"
  },
  "presence": { "agent": "orb", "speaker": "ring" },
  "tokens": {
    "--bg": "#1F2429",
    "--panel": "#262C32",
    "--panel-2": "#191D21",
    "--line": "rgba(255,255,255,.08)",
    "--sel": "rgba(255,255,255,.06)",
    "--fg": "#ECE7DE",
    "--fg-2": "#B4ADA1",
    "--dim": "#8B857B",
    "--accent": "#8FF0D2",
    "--accent-fg": "#0F2A22",
    "--glow": "rgba(143,240,210,.35)",
    "--ok": "#8FF0D2",
    "--warn": "#F0B35C",
    "--warn-bg": "rgba(240,179,92,.10)",
    "--bad": "#D8908A",
    "--exec": "#E3C68F",
    "--read": "#8FF0D2",
    "--write": "#A9C9E4",
    "--ins-bg": "rgba(139,202,165,.14)",
    "--del-bg": "rgba(216,144,138,.14)",
    "--text": "14px",
    "--radius": "10px",
    "--radius-lg": "18px",
    "--shadow": "0 10px 40px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.06)",
    "--left-w": "236px",
    "--right-w": "392px"
  }
}
