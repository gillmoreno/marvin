{
  "id": "editorial",
  "name": "Editorial",
  "description": "Light. The room as a live, well-typeset document: warm paper, serif names, timestamps in the margin, voice rendered as ink.",
  "author": "Marvin",
  "scheme": "light",
  "fonts": {
    "ui": "Source Sans 3",
    "display": "Fraunces",
    "mono": "IBM Plex Mono",
    "google": "family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500"
  },
  "presence": { "agent": "ink", "speaker": "ink" },
  "tokens": {
    "--bg": "#F5F0E6",
    "--panel": "#FBF8F1",
    "--panel-2": "#ECE5D6",
    "--line": "#D6CDBD",
    "--sel": "#EFE8DA",
    "--fg": "#1B1712",
    "--fg-2": "#463F37",
    "--dim": "#6B635A",
    "--accent": "#7A1E2B",
    "--accent-fg": "#FBF8F1",
    "--glow": "rgba(122,30,43,.25)",
    "--ok": "#3F7A4C",
    "--warn": "#8A5A12",
    "--warn-bg": "#F3EAD6",
    "--bad": "#8A2A2A",
    "--exec": "#7A1E2B",
    "--read": "#6B635A",
    "--write": "#1B1712",
    "--ins-bg": "#E3EDDA",
    "--del-bg": "#F2DEDB",
    "--text": "15px",
    "--radius": "2px",
    "--radius-lg": "3px",
    "--shadow": "none"
  }
}
